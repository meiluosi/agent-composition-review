        },
        {
          "id": "refresh_has_suffix_text",
          "requirement": "输出包含 |fresh。",
          "must": {
            "op": "contains",
            "args": [
              {
                "path": "output.label"
              },
              {
                "literal": "|fresh"
              }
            ]
          }
        }
