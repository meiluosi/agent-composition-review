    {
      "kind": "state_merge",
      "description": "prepare 的 count 补丁合入完整父状态；未写入的 label/left/right 从本次调用输入保留，再向 refresh 与 analysis 广播同一 superstep 快照。edges 仅绑定实际输出字段 count，不将补丁虚构成完整 State。"
    },
    {
      "kind": "parallel_fork",
      "after": "prepare",
      "branches": [
        "refresh",
        "analysis"
      ],
      "description": "app.py:57-58 两条同源边，无 refresh→analysis 顺序依赖。"
    },
    {
      "kind": "compound_input",
      "container": "analysis",
      "branches": [
        "left",
        "right"
      ],
      "bindings": [
        {
          "boundary_input": "count",
          "branch_input": "count"
