{
  "schema_version": 1,
  "types": {
    "State": {
      "count": {
        "type": "number"
      },
      "label": {
        "type": "string"
      },
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    },
    "CountUpdate": {
      "count": {
        "type": "number"
      }
    },
    "LabelUpdate": {
      "label": {
        "type": "string"
      }
    },
    "LeftUpdate": {
      "left": {
        "type": "number"
      }
    },
    "RightUpdate": {
      "right": {
        "type": "number"
      }
    },
    "AnalysisOutput": {
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    }
  },
  "resources": {
    "state.count": "父状态 count；prepare 更新后作为子图输入快照的一部分。",
    "state.label": "父状态 label；refresh 与子图读取同一轮的旧值，refresh 更新仅在父轮次合并。",
    "state.left": "保留调用者初始 left，并接收子图 left 更新。",
    "state.right": "保留调用者初始 right，并接收子图 right 更新。",
    "calls": "调用者提供的可选日志对象；每个图闭包捕获它，不由模块保存全局日志。",
    "parent_gate": "调用者提供的可选屏障；refresh 与 left 调用 wait，可能改变屏障内部状态。",
    "child_gate": "调用者提供的可选屏障；left 与 right 调用 wait，可能改变屏障内部状态。"
  },
  "actions": [
    {
      "id": "prepare",
      "meaning": "build_graph.prepare：记录 prepare，并以输入 count + 7 返回 count 增量字段。",
      "input_type": "State",
      "output_type": "CountUpdate",
      "reads": [
        "state.count",
        "calls"
      ],
      "writes": [
        "state.count",
        "calls"
      ],
      "pre": [
        {
          "id": "prepare_input",
          "requirement": "成功执行需要相应输入字段；字段类型由 input_type 声明。",
          "must": {
            "op": "subset",
            "args": [
              {
                "literal": [
                  "count"
                ]
              },
              {
                "path": "input"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "prepare_output",
          "requirement": "成功返回的更新仅包含该动作所属字段。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "subset",
                "args": [
                  {
                    "literal": [
                      "count"
                    ]
                  },
                  {
                    "path": "output"
                  }
                ]
              },
              {
                "op": "subset",
                "args": [
                  {
                    "path": "output"
                  },
                  {
                    "literal": [
                      "count"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "requirements": [
        {
          "description": "output.count = input.count + 7",
          "verification": "test_review.py 中的实际输出断言；该格式的表达式不支持加法或字符串拼接，未将公式伪装成可执行谓词。"
        },
        {
          "description": "在提供 calls 时，本动作每次执行在入口追加一次动作名。异常执行也可能留下入口记录。",
          "verification": "代码 record 调用位置；成功调用由 Counter 断言检查次数。"
        }
      ]
    },
    {
      "id": "refresh",
      "meaning": "build_graph.refresh：记录 refresh，等待可选父屏障，返回追加 |fresh 的 label。",
      "input_type": "State",
      "output_type": "LabelUpdate",
      "reads": [
        "state.label",
        "calls",
        "parent_gate"
      ],
      "writes": [
        "state.label",
        "calls",
        "parent_gate"
      ],
      "pre": [
        {
          "id": "refresh_input",
          "requirement": "成功执行需要相应输入字段；字段类型由 input_type 声明。",
          "must": {
            "op": "subset",
            "args": [
              {
                "literal": [
                  "label"
                ]
              },
              {
                "path": "input"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "refresh_output",
          "requirement": "成功返回的更新仅包含该动作所属字段。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "subset",
                "args": [
                  {
                    "literal": [
                      "label"
                    ]
                  },
                  {
                    "path": "output"
                  }
                ]
              },
              {
                "op": "subset",
                "args": [
                  {
                    "path": "output"
                  },
                  {
                    "literal": [
                      "label"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "requirements": [
        {
          "description": "output.label = input.label + '|fresh'",
          "verification": "test_review.py 中的实际输出断言；该格式的表达式不支持加法或字符串拼接，未将公式伪装成可执行谓词。"
        },
        {
          "description": "在提供 calls 时，本动作每次执行在入口追加一次动作名。异常执行也可能留下入口记录。",
          "verification": "代码 record 调用位置；成功调用由 Counter 断言检查次数。"
        }
      ]
    },
    {
      "id": "left",
      "meaning": "build_graph.left：记录 left，等待可选父、子屏障，累加准备后的 count 与旧 label 长度。",
      "input_type": "State",
      "output_type": "LeftUpdate",
      "reads": [
        "state.left",
        "state.count",
        "state.label",
        "calls",
        "parent_gate",
        "child_gate"
      ],
      "writes": [
        "state.left",
        "calls",
        "parent_gate",
        "child_gate"
      ],
      "pre": [
        {
          "id": "left_input",
          "requirement": "成功执行需要相应输入字段；字段类型由 input_type 声明。",
          "must": {
            "op": "subset",
            "args": [
              {
                "literal": [
                  "left",
                  "count",
                  "label"
                ]
              },
              {
                "path": "input"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "left_output",
          "requirement": "成功返回的更新仅包含该动作所属字段。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "subset",
                "args": [
                  {
                    "literal": [
                      "left"
                    ]
                  },
                  {
                    "path": "output"
                  }
                ]
              },
              {
                "op": "subset",
                "args": [
                  {
                    "path": "output"
                  },
                  {
                    "literal": [
                      "left"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "requirements": [
        {
          "description": "output.left = input.left + input.count + len(input.label)",
          "verification": "test_review.py 中的实际输出断言；该格式的表达式不支持加法或字符串拼接，未将公式伪装成可执行谓词。"
        },
        {
          "description": "在提供 calls 时，本动作每次执行在入口追加一次动作名。异常执行也可能留下入口记录。",
          "verification": "代码 record 调用位置；成功调用由 Counter 断言检查次数。"
        }
      ]
    },
    {
      "id": "right",
      "meaning": "build_graph.right：记录 right，等待可选子屏障，累加准备后的 count 减旧 label 长度。",
      "input_type": "State",
      "output_type": "RightUpdate",
      "reads": [
        "state.right",
        "state.count",
        "state.label",
        "calls",
        "child_gate"
      ],
      "writes": [
        "state.right",
        "calls",
        "child_gate"
      ],
      "pre": [
        {
          "id": "right_input",
          "requirement": "成功执行需要相应输入字段；字段类型由 input_type 声明。",
          "must": {
            "op": "subset",
            "args": [
              {
                "literal": [
                  "right",
                  "count",
                  "label"
                ]
              },
              {
                "path": "input"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "right_output",
          "requirement": "成功返回的更新仅包含该动作所属字段。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "subset",
                "args": [
                  {
                    "literal": [
                      "right"
                    ]
                  },
                  {
                    "path": "output"
                  }
                ]
              },
              {
                "op": "subset",
                "args": [
                  {
                    "path": "output"
                  },
                  {
                    "literal": [
                      "right"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "requirements": [
        {
          "description": "output.right = input.right + input.count - len(input.label)",
          "verification": "test_review.py 中的实际输出断言；该格式的表达式不支持加法或字符串拼接，未将公式伪装成可执行谓词。"
        },
        {
          "description": "在提供 calls 时，本动作每次执行在入口追加一次动作名。异常执行也可能留下入口记录。",
          "verification": "代码 record 调用位置；成功调用由 Counter 断言检查次数。"
        }
      ]
    }
  ],
