{
  "schema_version": 1,
  "types": {
    "State": {
      "count": {
        "type": "number"
      },
      "label": {
        "type": "string"
      },
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    },
    "CountPatch": {
      "count": {
        "type": "number"
      }
    },
    "LabelPatch": {
      "label": {
        "type": "string"
      }
    },
    "LeftPatch": {
      "left": {
        "type": "number"
      }
    },
    "RightPatch": {
      "right": {
        "type": "number"
      }
    },
    "AnalysisOutput": {
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    }
  },
  "resources": {
    "parent_count": {
      "meaning": "parent 图的 count 状态通道；每次 invoke 独立。"
    },
    "parent_label": {
      "meaning": "parent 图的 label 状态通道；每次 invoke 独立。"
    },
    "parent_left": {
      "meaning": "parent 图的 left 状态通道；每次 invoke 独立。"
    },
    "parent_right": {
      "meaning": "parent 图的 right 状态通道；每次 invoke 独立。"
    },
    "child_count": {
      "meaning": "child 图的 count 状态通道；每次 invoke 独立。"
    },
    "child_label": {
      "meaning": "child 图的 label 状态通道；每次 invoke 独立。"
    },
    "child_left": {
      "meaning": "child 图的 left 状态通道；每次 invoke 独立。"
    },
    "child_right": {
      "meaning": "child 图的 right 状态通道；每次 invoke 独立。"
    },
    "calls": {
      "meaning": "调用者可选日志列表；record 在动作开始时 append，不是成功完成日志。"
    },
    "parent_gate": {
      "meaning": "refresh 与 left 共享的可选 wait 屏障；由调用者提供。"
    },
    "child_gate": {
      "meaning": "left 与 right 共享的可选 wait 屏障；由调用者提供。"
    }
  },
  "actions": [
    {
      "id": "prepare",
      "meaning": "build_graph.prepare：记录 prepare 并生成 count + 7 补丁。",
      "input_type": "State",
      "output_type": "CountPatch",
      "reads": [
        "parent_count",
        "calls"
      ],
      "writes": [
        "parent_count",
        "calls"
      ],
      "pre": [
        {
          "id": "prepare.snapshot",
          "requirement": "输入字段来自该动作执行前的所属图快照；before/after 是逻辑状态，未在本次测试中逐节点采集。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "path": "input.count"
                  },
                  {
                    "path": "before.parent_count"
                  }
                ]
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "prepare.patch",
          "requirement": "返回字段在所属图提交后对应状态更新；算术要求另列 requirements，以实际行为测试验证。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "path": "output.count"
                  },
                  {
                    "path": "after.parent_count"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "refresh",
      "meaning": "build_graph.refresh：记录 refresh、等待可选父屏障并生成追加 |fresh 的 label 补丁。",
      "input_type": "State",
      "output_type": "LabelPatch",
      "reads": [
        "parent_label",
        "calls",
        "parent_gate"
      ],
      "writes": [
        "parent_label",
        "calls",
        "parent_gate"
      ],
      "pre": [
        {
          "id": "refresh.snapshot",
          "requirement": "输入字段来自该动作执行前的所属图快照；before/after 是逻辑状态，未在本次测试中逐节点采集。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "path": "input.label"
                  },
                  {
                    "path": "before.parent_label"
                  }
                ]
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "refresh.patch",
          "requirement": "返回字段在所属图提交后对应状态更新；算术要求另列 requirements，以实际行为测试验证。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "path": "output.label"
                  },
                  {
                    "path": "after.parent_label"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "left",
      "meaning": "build_graph.left：记录 left，等待父/子屏障，以子图完整输入计算 left 累加值。",
      "input_type": "State",
      "output_type": "LeftPatch",
      "reads": [
        "child_count",
        "child_label",
        "child_left",
        "calls",
        "parent_gate",
        "child_gate"
      ],
      "writes": [
        "child_left",
        "calls",
        "parent_gate",
        "child_gate"
      ],
      "pre": [
        {
          "id": "left.snapshot",
          "requirement": "输入字段来自该动作执行前的所属图快照；before/after 是逻辑状态，未在本次测试中逐节点采集。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "path": "input.count"
                  },
                  {
                    "path": "before.child_count"
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "path": "input.label"
                  },
                  {
                    "path": "before.child_label"
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "path": "input.left"
                  },
                  {
                    "path": "before.child_left"
                  }
                ]
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "left.patch",
          "requirement": "返回字段在所属图提交后对应状态更新；算术要求另列 requirements，以实际行为测试验证。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "path": "output.left"
                  },
                  {
                    "path": "after.child_left"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "right",
      "meaning": "build_graph.right：记录 right，等待子屏障，以子图完整输入计算 right 累加值。",
      "input_type": "State",
      "output_type": "RightPatch",
      "reads": [
        "child_count",
        "child_label",
        "child_right",
        "calls",
        "child_gate"
      ],
      "writes": [
        "child_right",
        "calls",
        "child_gate"
      ],
      "pre": [
        {
          "id": "right.snapshot",
          "requirement": "输入字段来自该动作执行前的所属图快照；before/after 是逻辑状态，未在本次测试中逐节点采集。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "path": "input.count"
                  },
                  {
                    "path": "before.child_count"
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "path": "input.label"
                  },
                  {
                    "path": "before.child_label"
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "path": "input.right"
                  },
                  {
                    "path": "before.child_right"
                  }
                ]
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "right.patch",
          "requirement": "返回字段在所属图提交后对应状态更新；算术要求另列 requirements，以实际行为测试验证。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "path": "output.right"
                  },
                  {
                    "path": "after.child_right"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "analysis_export",
      "meaning": "child.compile() 的输出边界，作为父图 analysis 节点发布 AnalysisOutput；不是新增 Python 动作，也不调用 record。",
      "input_type": "State",
      "output_type": "AnalysisOutput",
      "reads": [
        "child_left",
        "child_right"
      ],
      "writes": [
        "parent_left",
        "parent_right"
      ],
      "pre": [
        {
          "id": "analysis_export.ready",
          "requirement": "子分支结束后的子图快照提供 left/right，输入表示输出投影前快照。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "path": "input.left"
                  },
                  {
                    "path": "before.child_left"
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "path": "input.right"
                  },
                  {
                    "path": "before.child_right"
                  }
                ]
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "analysis_export.values",
          "requirement": "仅将子图已算出的 left/right 发布回父图。",
          "must": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "path": "output.left"
                  },
                  {
                    "path": "input.left"
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "path": "output.right"
                  },
                  {
                    "path": "input.right"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "analysis_export.width",
          "requirement": "AnalysisOutput 类型要求 left/right；输出字段总数为 2，排除旧 count/label 回写。",
          "must": {
            "op": "eq",
            "args": [
              {
                "count": {
                  "path": "output"
                }
              },
              {
                "literal": 2
              }
            ]
          }
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "prepare",
      "to": "refresh",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ]
    },
    {
      "from": "prepare",
      "to": "left",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ]
    },
    {
      "from": "prepare",
      "to": "right",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ]
    },
    {
      "from": "left",
      "to": "analysis_export",
      "bindings": [
        {
          "output": "left",
          "input": "left"
        }
      ]
    },
    {
      "from": "right",
      "to": "analysis_export",
      "bindings": [
        {
          "output": "right",
          "input": "right"
        }
      ]
    }
  ],
  "required_actions": [
    "prepare",
    "refresh",
    "left",
    "right",
    "analysis_export"
  ],
  "relations": [
    {
      "kind": "snapshot_fanout",
      "from": "prepare",
      "to": [
        "refresh",
        "left",
        "right"
      ],
      "meaning": "父图先提交 prepare 的 count 补丁；父分支 refresh 与 analysis 读取同一准备后快照。analysis 的输入包含原 label/left/right，子图 START 再同时启动 left/right。edges 中 prepare 到子分支表示经 analysis 输入边界的字段传递，不是额外直接连线。"
    },
    {
      "kind": "parallel",
      "members": [
        "refresh",
        "analysis_export"
      ],
      "meaning": "父图 refresh 与整个 analysis 子图并行；analysis_export 仅表示后者的输出阶段。refresh 与 left 的父屏障验证重叠。"
    },
    {
      "kind": "parallel",
      "members": [
        "left",
        "right"
      ],
      "meaning": "子图 START 两条边分叉；child_gate 验证两个动作重叠。"
    },
    {
      "kind": "join",
      "members": [
        "refresh",
        "analysis_export"
      ],
      "destination": "parent END",
      "meaning": "父图合并不相交的 label 与 left/right 更新，保留 prepare 的 count。最终仍仅有 State 四字段。"
    },
    {
      "kind": "lifetime",
      "meaning": "每次 build_graph 创建父图、子图和闭包。复用编译图不持有跨 invoke 的业务状态。显式复用同一个 calls/gate 对象会共享该外部资源，独立性不包含调用者故意共享的日志或屏障。"
    }
  ],
  "requirements": [
    {
      "id": "arithmetic",
      "statement": "对输入 c, label, l, r：结果 count=c+7，label=label+\"|fresh\"，left=l+(c+7)+len(label)，right=r+(c+7)-len(label)。len 是 Python 字符串长度，保留原始累加基数。",
      "verification": "test_values_and_repeated_calls 对 48 个输入组合及 4 次结果回馈调用逐字段比较；同时校验输入字典未变。表达式语言没有加法/字符串拼接，未将完整算术伪装成可执行谓词。"
    },
    {
      "id": "execution",
      "statement": "成功调用 prepare/refresh/left/right 每个恰好记录一次；保留真实编译父图和可复用编译子图、两层并行。",
      "verification": "test_both_parallel_boundaries 连续 3 次使用两个 Barrier(2, timeout=5)；test_reusable_child_and_topology 检查编译类型、分叉连线及直接子图调用。"
    },
    {
      "id": "isolation",
      "statement": "完整 State 输入的普通 invoke/ainvoke 之间、分别构建的图之间业务状态独立。",
      "verification": "test_concurrent_invocations_and_graph_isolation 在两个图上并发执行 20 次并检查各自日志；test_async_invocation 在同一图上并发执行 5 次。"
    },
    {
      "id": "failure",
      "statement": "动作异常向调用者传播；日志在动作开始时记录，失败路径不要求所有动作都完成。required_actions 仅用于成功完整执行。",
      "verification": "test_exceptions_propagate 对父/子屏障注入 RuntimeError 子类，并验证无效 count 的 TypeError。"
    }
  ],
  "scope": {
    "description": "当前 app.py 的父图准备、父/子两层并行及子图输出投影。动作输出均为补丁；analysis_export 输入特指子图完成后的快照。结构声明与行为测试分开记录。",
    "limitations": [
      "types 的 number 是格式允许的宽类型；业务测试域是 Python int 与 str 的完整 State，不声称 TypedDict 在运行时校验输入。",
      "省略 LangGraph 内部调度、通道初始化及内置 END 的内部实现；通过真实安装框架执行验证相关语义。",
      "pre/post 是逻辑契约，未生成带完整 before/after 的逐节点轨迹，也未用顺序 trace 检查器证明并发性质。格式检查只检查声明。",
      "有限并发/屏障测试不覆盖所有调度；未测试进程间执行、持久化、检查点恢复、取消、外部重试或自定义调度配置。",
      "读写集合来自代码检查；calls 和 gates 包含外部副作用，未声称任意调用者自定义对象线程安全。",
      "原始副本的子图输出形状对照失败仅说明修复边界变化；原始违规依据是公开调用及双屏障调用的 label 并发写冲突。"
    ],
    "evidence": [
      {
        "path": "app.py",
        "start": 6,
        "end": 15,
        "supports": "完整状态四字段；子图输出明确限定 left/right。"
      },
      {
        "path": "app.py",
        "start": 18,
        "end": 25,
        "supports": "公开构造接口、可选日志、prepare 的单次记录和 count + 7。"
      },
      {
        "path": "app.py",
        "start": 27,
        "end": 45,
        "supports": "refresh/left/right 的实际公式、日志和两层屏障；无异常吞噬。"
      },
      {
        "path": "app.py",
        "start": 47,
        "end": 52,
        "supports": "子图保留完整 State，使用 AnalysisOutput 收窄输出，并从 START 并行启动两个动作。"
      },
      {
        "path": "app.py",
        "start": 53,
        "end": 62,
        "supports": "父图包含 prepare、refresh、编译子图 analysis；prepare 后分叉，父图仍返回 compile()。"
      }
    ]
  },
  "verification": {
    "behavior": {
      "command": "./run_python test_review.py app",
      "status": "passed",
      "tests": 6
    },
    "smoke": {
      "command": "./run_python smoke.py",
      "status": "passed after repair",
      "result": {
        "count": 8,
        "label": "old|fresh",
        "left": 13,
        "right": 8
      }
    },
    "baseline": {
      "command": "./run_python smoke.py (before repair)",
      "status": "failed",
      "exception": "InvalidUpdateError at label"
    },
    "baseline_comparison": {
      "command": "./run_python test_review.py original GraphReview.test_both_parallel_boundaries GraphReview.test_reusable_child_and_topology",
      "status": "one error and one assertion failure",
      "meaning": "父图 label 冲突复现；原始子图仍返回四字段。"
    }
  }
}
