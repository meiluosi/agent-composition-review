{
  "schema_version": 1,
  "types": {
    "State": {
      "count": {
        "type": "number"
      },
      "label": {
        "type": "string"
      },
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    },
    "PrepareUpdate": {
      "count": {
        "type": "number"
      }
    },
    "RefreshUpdate": {
      "label": {
        "type": "string"
      }
    },
    "LeftUpdate": {
      "left": {
        "type": "number"
      }
    },
    "RightUpdate": {
      "right": {
        "type": "number"
      }
    },
    "AnalysisOutput": {
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    }
  },
  "resources": {
    "parent.count": "本次父图调用的 count 通道",
    "parent.label": "本次父图调用的 label 通道",
    "parent.left": "本次父图调用的 left 通道",
    "parent.right": "本次父图调用的 right 通道",
    "analysis.count": "从 prepare 后父图状态复制的子图 count",
    "analysis.label": "从父分叉快照复制的子图 label，尚未 refresh",
    "analysis.left": "子图 left 通道，初始值来自父图原始 left",
    "analysis.right": "子图 right 通道，初始值来自父图原始 right",
    "calls": "调用者可选列表；每次进入动作时追加一次名称",
    "parent_gate": "调用者可选屏障，由 refresh 和 left 等待",
    "child_gate": "调用者可选屏障，由 left 和 right 等待"
  },
  "actions": [
    {
      "id": "prepare",
      "meaning": "build_graph.prepare：记录动作，并将 count 加 7。",
      "input_type": "State",
      "output_type": "PrepareUpdate",
      "reads": [
        "parent.count"
      ],
      "writes": [
        "parent.count",
        "calls"
      ],
      "pre": [
        {
          "id": "prepare_snapshot_count",
          "requirement": "实际节点输入保留本次调用的原始 count",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.count"
              },
              {
                "path": "context.initial.count"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "prepare_increases_count",
          "requirement": "精确加 7 的必要条件：count 不减；精确公式另见 requirements.arithmetic。",
          "must": {
            "op": "ge",
            "args": [
              {
                "path": "output.count"
              },
              {
                "path": "input.count"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "refresh",
      "meaning": "build_graph.refresh：记录动作，等待可选父屏障，然后给 label 追加 |fresh。",
      "input_type": "State",
      "output_type": "RefreshUpdate",
      "reads": [
        "parent.label",
        "parent_gate"
      ],
      "writes": [
        "parent.label",
        "calls",
        "parent_gate"
      ],
      "pre": [
        {
          "id": "refresh_snapshot_label",
          "requirement": "实际节点输入保留本次调用的原始 label",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.label"
              },
              {
                "path": "context.initial.label"
              }
            ]
          }
        },
        {
          "id": "refresh_prepared_count",
          "requirement": "节点读取 prepare 输出的 count",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.count"
              },
              {
                "path": "context.actions.prepare.output.count"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "refresh_contains_suffix",
          "requirement": "追加后必须包含 |fresh；此谓词不单独证明恰好追加一次。",
          "must": {
            "op": "contains",
            "args": [
              {
                "path": "output.label"
              },
              {
                "literal": "|fresh"
              }
            ]
          }
        },
        {
          "id": "refresh_preserves_text",
          "requirement": "追加后必须保留原 label；精确拼接由行为测试验证。",
          "must": {
            "op": "contains",
            "args": [
              {
                "path": "output.label"
              },
              {
                "path": "input.label"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "left",
      "meaning": "build_graph.left：记录动作，等待可选两层屏障，以原 left 和分叉快照更新左值。",
      "input_type": "State",
      "output_type": "LeftUpdate",
      "reads": [
        "analysis.left",
        "analysis.count",
        "analysis.label",
        "parent_gate",
        "child_gate"
      ],
      "writes": [
        "analysis.left",
        "calls",
        "parent_gate",
        "child_gate"
      ],
      "pre": [
        {
          "id": "left_snapshot_label",
          "requirement": "实际节点输入保留本次调用的原始 label",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.label"
              },
              {
                "path": "context.initial.label"
              }
            ]
          }
        },
        {
          "id": "left_snapshot_left",
          "requirement": "实际节点输入保留本次调用的原始 left",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.left"
              },
              {
                "path": "context.initial.left"
              }
            ]
          }
        },
        {
          "id": "left_prepared_count",
          "requirement": "节点读取 prepare 输出的 count",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.count"
              },
              {
                "path": "context.actions.prepare.output.count"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "left_nonnegative_increment",
          "requirement": "当输入 count 非负时，左值不减；仅为精确公式的必要条件。",
          "must": {
            "op": "ge",
            "args": [
              {
                "path": "output.left"
              },
              {
                "path": "input.left"
              }
            ]
          },
          "when": {
            "op": "ge",
            "args": [
              {
                "path": "input.count"
              },
              {
                "literal": 0
              }
            ]
          }
        }
      ]
    },
    {
      "id": "right",
      "meaning": "build_graph.right：记录动作，等待可选子屏障，以原 right 和分叉快照更新右值。",
      "input_type": "State",
      "output_type": "RightUpdate",
      "reads": [
        "analysis.right",
        "analysis.count",
        "analysis.label",
        "child_gate"
      ],
      "writes": [
        "analysis.right",
        "calls",
        "child_gate"
      ],
      "pre": [
        {
          "id": "right_snapshot_label",
          "requirement": "实际节点输入保留本次调用的原始 label",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.label"
              },
              {
                "path": "context.initial.label"
              }
            ]
          }
        },
        {
          "id": "right_snapshot_right",
          "requirement": "实际节点输入保留本次调用的原始 right",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.right"
              },
              {
                "path": "context.initial.right"
              }
            ]
          }
        },
        {
          "id": "right_prepared_count",
          "requirement": "节点读取 prepare 输出的 count",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.count"
              },
              {
                "path": "context.actions.prepare.output.count"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "right_nonpositive_increment",
          "requirement": "当输入 count 非正时，右值不增；仅为精确公式的必要条件。",
          "must": {
            "op": "le",
            "args": [
              {
                "path": "output.right"
              },
              {
                "path": "input.right"
              }
            ]
          },
          "when": {
            "op": "le",
            "args": [
              {
                "path": "input.count"
              },
              {
                "literal": 0
              }
            ]
          }
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "prepare",
      "to": "refresh",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ],
      "meaning": "prepare 的部分更新经父状态合并后交接给父并行分支。"
    },
    {
      "from": "prepare",
      "to": "left",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ],
      "meaning": "prepare 的部分更新经父状态合并后交接，再经 analysis 子图输入边界到达分支。"
    },
    {
      "from": "prepare",
      "to": "right",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ],
      "meaning": "prepare 的部分更新经父状态合并后交接，再经 analysis 子图输入边界到达分支。"
    }
  ],
  "required_actions": [
    "prepare",
    "refresh",
    "left",
    "right"
  ],
  "relations": [
    {
      "kind": "parent_fork",
      "after": "prepare",
      "branches": [
        "refresh",
        "analysis"
      ],
      "meaning": "父 StateGraph 在 prepare 后同一 superstep 启动 refresh 和编译子图 analysis。analysis 是容器，不是额外业务动作。"
    },
    {
      "kind": "child_fork",
      "container": "analysis",
      "branches": [
        "left",
        "right"
      ],
      "meaning": "子图 START 同时连接两个分支；没有 left→right 或 refresh→left 的顺序依赖。"
    },
    {
      "kind": "snapshot",
      "from": "parent",
      "to": "analysis",
      "fields": [
        "count",
        "label",
        "left",
        "right"
      ],
      "meaning": "count 已 prepare；label、left、right 仍为调用初值；子图内两个分支共享此输入快照。"
    },
    {
      "kind": "projection_and_merge",
      "container": "analysis",
      "output_type": "AnalysisOutput",
      "bindings": [
        {
          "from": "analysis.left",
          "to": "parent.left"
        },
        {
          "from": "analysis.right",
          "to": "parent.right"
        }
      ],
      "meaning": "child output_schema 仅导出 left/right，父 refresh 仅更新 label，故无同轮重复写 label/count。"
    },
    {
      "kind": "completion",
      "branches": [
        "refresh",
        "analysis"
      ],
      "destination": "END",
      "meaning": "最终 State 保留 prepare 的 count、refresh 的 label 及子图两个结果。"
    },
    {
      "kind": "observability",
      "meaning": "calls 和 gate 是可选闭包引用；调用者显式共享这些对象时，它们也是共享的。屏障等待会改变屏障状态。"
    }
  ],
  "requirements": {
    "arithmetic": {
      "formula": "令调用初值为 c,t,l,r：最终 count=c+7，label=t+\"|fresh\"，left=l+c+7+len(t)，right=r+c+7-len(t)。",
      "verification": "test_review.py 的独立 expected oracle 验证精确公式；verify_model.py 另核对真实节点输入与部分输出。",
      "status": "代码直接实现，已在有限输入上运行验证；谓词语言不支持一般加减和拼接，未将精确公式冒充完整机器证明。"
    },
    "execution": {
      "requirement": "正常完成的每次调用中四动作各执行一次；保留两层并行与真实可复用编译子图；异常传播。",
      "verification": "Counter、两层 Barrier(2)、CompiledStateGraph、子图独立调用、注入异常测试。"
    },
    "isolation": {
      "requirement": "默认调用状态不跨调用或图实例泄漏。",
      "verification": "同一图顺序及并发调用、三个图并发调用；不同调用输入/结果逐一比较。"
    }
  },
  "scope": {
    "description": "当前 app.py 四个业务节点、父子分叉快照及子图输出投影。函数公开签名及返回真实 CompiledStateGraph 保持原样。",
    "event_convention": "条件事件中的 input/output 是 LangGraph debug 的 task.input/task_result.result；context.initial 为本次实际调用输入，context.actions 为该次观察到的四节点事件。verify_model.py 生成 trace.json 并检查这些条件。独立调用子图不会执行 prepare，不适用父图调用的 context 条件。",
    "limitations": [
      "类型格式 number 不能表达 int 的完整约束；app.py 的 TypedDict 也是类型提示，不是运行时输入校验。行为验证面向包含四个规定字段的整数/字符串输入。",
      "谓词只描述快照等式及部分必要条件，不能单独证明完整算术和字符串拼接；精确公式由源码检查与实际行为 oracle 验证。",
      "省略 LangGraph 内部通道、调度器和检查点实现；并行合并语义依赖已安装框架。未测试其他框架版本。",
      "有限次屏障和并发测试不能证明所有调度；未覆盖异步 API、外部取消、重试、持久化恢复或非默认执行配置。",
      "异常测试只保证观察到的异常向外传播；异常调用可能提前终止，四动作各一次的断言仅用于正常完成调用。",
      "调用者提供的恶意/不配对屏障、非线程安全 calls 对象或刻意跨图共享的观察对象不具备额外隔离保证。"
    ],
    "evidence": [
      {
        "path": "app.py",
        "start": 6,
        "end": 15,
        "supports": "State 四字段，AnalysisOutput 仅 left/right。"
      },
      {
        "path": "app.py",
        "start": 18,
        "end": 25,
        "supports": "公开接口、每节点记录机制与 count 加 7。"
      },
      {
        "path": "app.py",
        "start": 27,
        "end": 45,
        "supports": "refresh/left/right 的公式、可选屏障和异常未经捕获传播。"
      },
      {
        "path": "app.py",
        "start": 47,
        "end": 51,
        "supports": "子图完整 State 输入、窄输出及 START 两条并行边。"
      },
      {
        "path": "app.py",
        "start": 52,
        "end": 61,
        "supports": "父图 prepare 后分叉、真实编译子图、两分支 END 和真实编译返回值。"
      }
    ]
  },
  "validation": {
    "behavior_checks_executed": [
      "./run_python smoke.py",
      "./run_python test_review.py",
      "./run_python verify_model.py"
    ],
    "behavior_results": "smoke 得到 count=8,label=old|fresh,left=13,right=8；7 项 unittest 全部通过。",
    "inference": "窄输出边界使 refresh 与 analysis 的父图写集合不相交；未将结构校验视为行为证明。",
    "trace_results": "3 次真实 LangGraph debug 轨迹已写入 trace.json；核对每个动作的输入快照、精确输出、子图输出投影、模型谓词及绑定，全部通过。结构引用和行号范围也通过检查；app.py 与 original.py 字节相同。"
  }
}
