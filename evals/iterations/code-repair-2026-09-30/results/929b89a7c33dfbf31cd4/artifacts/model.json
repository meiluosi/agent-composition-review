{
  "schema_version": 1,
  "types": {
    "State": {
      "count": {
        "type": "number"
      },
      "label": {
        "type": "string"
      },
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    },
    "CountPatch": {
      "count": {
        "type": "number"
      }
    },
    "LabelPatch": {
      "label": {
        "type": "string"
      }
    },
    "LeftPatch": {
      "left": {
        "type": "number"
      }
    },
    "RightPatch": {
      "right": {
        "type": "number"
      }
    },
    "AnalysisResult": {
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    }
  },
  "resources": {
    "state.count": "当前调用的父/子图 count 状态通道。",
    "state.label": "当前调用的父/子图 label 状态通道；子图取得 refresh 之前的快照。",
    "state.left": "当前调用的 left 状态通道，分析以传入基值计算新值。",
    "state.right": "当前调用的 right 状态通道，分析以传入基值计算新值。",
    "calls": "调用者可选的动作记录容器；闭包捕获，非模块全局变量。",
    "parent_gate": "调用者可选的屏障对象，refresh 与 left 调用 wait。",
    "child_gate": "调用者可选的屏障对象，left 与 right 调用 wait。"
  },
  "actions": [
    {
      "id": "prepare",
      "input_type": "State",
      "output_type": "CountPatch",
      "reads": [
        "state.count"
      ],
      "writes": [
        "state.count",
        "calls"
      ],
      "pre": [],
      "post": [
        {
          "id": "count_increases",
          "requirement": "必要条件：count 增加；精确增量另见 requirements。",
          "must": {
            "op": "ge",
            "args": [
              {
                "path": "output.count"
              },
              {
                "path": "input.count"
              }
            ]
          }
        }
      ],
      "meaning": "build_graph.prepare：记录 prepare，返回 count + 7 补丁。"
    },
    {
      "id": "refresh",
      "input_type": "State",
      "output_type": "LabelPatch",
      "reads": [
        "state.label",
        "parent_gate"
      ],
      "writes": [
        "state.label",
        "calls",
        "parent_gate"
      ],
      "pre": [],
      "post": [
        {
          "id": "retains_label",
          "requirement": "必要条件：输出包含原 label。",
          "must": {
            "op": "contains",
            "args": [
              {
                "path": "output.label"
              },
              {
                "path": "input.label"
              }
            ]
          }
        },
        {
          "id": "has_fresh",
          "requirement": "必要条件：输出包含 |fresh；精确后缀规则另见 requirements。",
          "must": {
            "op": "contains",
            "args": [
              {
                "path": "output.label"
              },
              {
                "literal": "|fresh"
              }
            ]
          }
        }
      ],
      "meaning": "build_graph.refresh：记录 refresh，等待可选父屏障，返回追加 |fresh 的 label 补丁。"
    },
    {
      "id": "analysis_entry",
      "input_type": "State",
      "output_type": "State",
      "reads": [
        "state.count",
        "state.label",
        "state.left",
        "state.right"
      ],
      "writes": [],
      "pre": [],
      "post": [
        {
          "id": "snapshot_count",
          "requirement": "边界传递字段 count，不改变其值。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.count"
              },
              {
                "path": "input.count"
              }
            ]
          }
        },
        {
          "id": "snapshot_label",
          "requirement": "边界传递字段 label，不改变其值。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.label"
              },
              {
                "path": "input.label"
              }
            ]
          }
        },
        {
          "id": "snapshot_left",
          "requirement": "边界传递字段 left，不改变其值。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.left"
              },
              {
                "path": "input.left"
              }
            ]
          }
        },
        {
          "id": "snapshot_right",
          "requirement": "边界传递字段 right，不改变其值。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.right"
              },
              {
                "path": "input.right"
              }
            ]
          }
        }
      ],
      "meaning": "child 的 START 输入边界（结构事件，不是新增 Python 动作）：接收 prepare 后的完整状态快照，供两个分析节点读取。"
    },
    {
      "id": "left",
      "input_type": "State",
      "output_type": "LeftPatch",
      "reads": [
        "state.left",
        "state.count",
        "state.label",
        "parent_gate",
        "child_gate"
      ],
      "writes": [
        "state.left",
        "calls",
        "parent_gate",
        "child_gate"
      ],
      "pre": [],
      "post": [],
      "meaning": "build_graph.left：记录 left，等待可选父/子屏障，计算 left + count + len(label)。"
    },
    {
      "id": "right",
      "input_type": "State",
      "output_type": "RightPatch",
      "reads": [
        "state.right",
        "state.count",
        "state.label",
        "child_gate"
      ],
      "writes": [
        "state.right",
        "calls",
        "child_gate"
      ],
      "pre": [],
      "post": [],
      "meaning": "build_graph.right：记录 right，等待可选子屏障，计算 right + count - len(label)。"
    },
    {
      "id": "analysis_exit",
      "input_type": "AnalysisResult",
      "output_type": "AnalysisResult",
      "reads": [
        "state.left",
        "state.right"
      ],
      "writes": [
        "state.left",
        "state.right"
      ],
      "pre": [],
      "post": [
        {
          "id": "publish_left",
          "requirement": "边界传递字段 left，不改变其值。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.left"
              },
              {
                "path": "input.left"
              }
            ]
          }
        },
        {
          "id": "publish_right",
          "requirement": "边界传递字段 right，不改变其值。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.right"
              },
              {
                "path": "input.right"
              }
            ]
          }
        }
      ],
      "meaning": "child.compile() 的输出边界：合并两个分支的补丁，通过 AnalysisResult 只向父 analysis 节点发布 left/right。边界本身不记录 calls。"
    }
  ],
  "edges": [
    {
      "from": "prepare",
      "to": "refresh",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ]
    },
    {
      "from": "prepare",
      "to": "analysis_entry",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ]
    },
    {
      "from": "analysis_entry",
      "to": "left",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        },
        {
          "output": "label",
          "input": "label"
        },
        {
          "output": "left",
          "input": "left"
        },
        {
          "output": "right",
          "input": "right"
        }
      ]
    },
    {
      "from": "analysis_entry",
      "to": "right",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        },
        {
          "output": "label",
          "input": "label"
        },
        {
          "output": "left",
          "input": "left"
        },
        {
          "output": "right",
          "input": "right"
        }
      ]
    },
    {
      "from": "left",
      "to": "analysis_exit",
      "bindings": [
        {
          "output": "left",
          "input": "left"
        }
      ]
    },
    {
      "from": "right",
      "to": "analysis_exit",
      "bindings": [
        {
          "output": "right",
          "input": "right"
        }
      ]
    }
  ],
  "relations": [
    {
      "kind": "state_inheritance",
      "description": "prepare 只写 count。父状态保留调用输入的 label、left、right，并将完整合并状态交给 refresh 和 analysis_entry。edges 中的 count 绑定不是完整输入的唯一来源。"
    },
    {
      "kind": "parallel",
      "members": [
        "refresh",
        "analysis_entry"
      ],
      "after": "prepare",
      "description": "父图两条出边启动同一轮的 refresh 与 analysis。analysis_entry 到 analysis_exit 为可复用编译子图的生命周期。"
    },
    {
      "kind": "parallel",
      "members": [
        "left",
        "right"
      ],
      "after": "analysis_entry",
      "description": "child START 同时连接 left 与 right；两者无先后依赖。"
    },
    {
      "kind": "parent_merge",
      "members": [
        "refresh",
        "analysis_exit"
      ],
      "description": "父图 END 前保留 prepare 的 count，合并 refresh 的 label 和 analysis_exit 的 left/right。最终只有 State 的四个字段。此关系不是 refresh 到 analysis 的顺序边。"
    },
    {
      "kind": "optional_effects",
      "description": "calls 非 None 时，每个业务动作开始时 append 一次；gate 非 None 时执行 wait。失败时保留已发生的记录，异常不被本实现捕获。"
    }
  ],
  "required_actions": [
    "prepare",
    "refresh",
    "analysis_entry",
    "left",
    "right",
    "analysis_exit"
  ],
  "requirements": [
    {
      "id": "exact_result",
      "requirement": "对于完整合法输入 s，令 c=s.count+7、n=len(s.label)。输出必须为 count=c、label=s.label+\"|fresh\"、left=s.left+c+n、right=s.right+c-n。",
      "verification": "test_review.py 的值测试、连续调用测试、并发和异步测试对完整输出字典进行精确比较；代码中的四个公式支持此推断。当前谓词词汇无法直接表示所需的加法与字符串拼接，因此 post 中的必要条件不是该公式的完整证明。"
    },
    {
      "id": "write_ownership",
      "requirement": "子图读取完整 State，但向父图只发布 left/right，不回写 count/label。",
      "verification": "AnalysisResult 与 output_schema 静态依据；直接复用子图测试和父图 stream 更新测试检查实际输出字段。"
    },
    {
      "id": "parallelism",
      "requirement": "保留父分支与子分支两处并行及真实编译子图。",
      "verification": "test_both_parallel_boundaries 在两层同时使用有超时的两方 Barrier，连续完成 6 次；拓扑与 CompiledStateGraph 类型检查。"
    },
    {
      "id": "isolation_and_calls",
      "requirement": "完整成功调用的四个业务动作分别记录一次；重复调用和不同图不泄漏状态。",
      "verification": "逐次动作 Counter、输入不变测试、连续调用、同图 24 次并发、6 个图独立屏障与日志测试、8 次异步调用。"
    },
    {
      "id": "error_propagation",
      "requirement": "不得吞掉动作或屏障异常。",
      "verification": "父/子 gate 注入异常并检查原异常实例传播；缺失字段和错误 count 类型分别验证 KeyError、TypeError。代码中无异常捕获。"
    }
  ],
  "scope": {
    "description": "当前 app.py 的 prepare、父图并行 refresh/analysis、子图并行 left/right，以及限制写回字段的子图边界。analysis_entry/exit 为实际框架交接的结构事件，不是 calls 中的额外动作。",
    "limitations": [
      "类型声明中的 number 对应代码 int；JSON 类型词汇无法区分整数。TypedDict 不提供运行时输入校验，本模型的业务契约针对 count/left/right 为整数且 label 为字符串的完整输入。",
      "pre 的空列表表示类型和正常执行前提以文字说明，未编码为谓词；left/right 的空 post 表示精确算术条件未编码。它们均不表示没有约束或已经证明。",
      "未展开 LangGraph 内部调度、状态通道实现、隐式子图结束与父 END 节点；snapshot 传递和合并依赖已安装框架的语义，并由实际行为测试佐证。",
      "屏障和并发测试覆盖有限调度，不构成所有运行环境和线程交错的证明。未验证跨进程、持久化检查点、故障重试、取消、外部自定义配置或其他框架版本。",
      "calls/gate 是调用者持有的可变对象；故意向多个图传入相同对象会共享该对象，调用者自定义对象的线程安全不由 build_graph 保证。未设置的或永不释放的外部屏障无法保证完成。",
      "每个动作恰好一次的测试针对正常完成且无外部重试的调用；失败调用可以只留下已启动动作的记录。"
    ],
    "evidence": [
      {
        "path": "app.py",
        "start": 6,
        "end": 15,
        "supports": "完整 State 与只含 left/right 的 AnalysisResult 输出契约。"
      },
      {
        "path": "app.py",
        "start": 18,
        "end": 25,
        "supports": "每个构图调用的局部闭包、可选 calls 记录、prepare 精确加 7。"
      },
      {
        "path": "app.py",
        "start": 27,
        "end": 45,
        "supports": "refresh 后缀、left/right 保留原基值的算术、动作记录、两个可选屏障；无异常吞掉逻辑。"
      },
      {
        "path": "app.py",
        "start": 47,
        "end": 52,
        "supports": "子图使用完整输入与受限输出，START 分叉到 left/right。"
      },
      {
        "path": "app.py",
        "start": 53,
        "end": 62,
        "supports": "父图包含真实编译子图，prepare 后并行 refresh 与 analysis，两个分支连接 END，返回编译父图。"
      }
    ]
  },
  "validation": {
    "executed": [
      {
        "command": "./run_python smoke.py",
        "result": "当前实现通过，输出 count=8、label=old|fresh、left=13、right=8。"
      },
      {
        "command": "./run_python test_review.py",
        "result": "9 项测试全部通过。"
      }
    ],
    "inferred": [
      "output_schema 划定父子图写回边界，消除 refresh 与 analysis 对 label 的并行写入冲突。",
      "实现中没有额外全局状态或辅助模块依赖。"
    ],
    "unverified": [
      "所有可能的线程交错、其他框架版本，以及 scope.limitations 中列出的扩展运行方式。"
    ]
  }
}
