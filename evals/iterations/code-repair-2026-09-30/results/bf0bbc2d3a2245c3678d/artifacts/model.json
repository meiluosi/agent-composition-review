        "calls",
        "parent_gate"
      ],
      "meaning": "build_graph.refresh：记录 refresh，可选等待父屏障，然后返回 label = input.label + \"|fresh\"。",
      "pre": [
        {
          "id": "refresh_label_present",
          "requirement": "input.label 必须存在且非 null；完整类型约束见 types。",
          "must": {
            "op": "ne",
            "args": [
              {
                "path": "input.label"
