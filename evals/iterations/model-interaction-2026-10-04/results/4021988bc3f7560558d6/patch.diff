+def _sqlite_string(value):
+    """Keep ordinary TEXT compatible; store lone surrogates losslessly as BLOB."""
+    try:
+        value.encode("utf-8")
+    except UnicodeEncodeError:
+        return value.encode("utf-8", errors="surrogatepass")
+    return value
 
 
