{
  "schema_version": 1,
  "types": {
    "State": {
      "count": {
        "type": "number"
      },
      "label": {
        "type": "string"
      },
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    },
    "prepareOutput": {
      "count": {
        "type": "number"
      }
    },
    "refreshOutput": {
      "label": {
        "type": "string"
      }
    },
    "leftOutput": {
      "left": {
        "type": "number"
      }
    },
    "rightOutput": {
      "right": {
        "type": "number"
      }
    },
    "AnalysisOutput": {
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    }
  },
  "resources": {
    "parent.count": "parent 图本次调用的 count 状态通道",
    "parent.label": "parent 图本次调用的 label 状态通道",
    "parent.left": "parent 图本次调用的 left 状态通道",
    "parent.right": "parent 图本次调用的 right 状态通道",
    "child.count": "child 图本次调用的 count 状态通道",
    "child.label": "child 图本次调用的 label 状态通道",
    "child.left": "child 图本次调用的 left 状态通道",
    "child.right": "child 图本次调用的 right 状态通道",
    "calls": "可选的外部动作记录列表；调用方若复用同一个列表则记录自然累积",
    "parent_gate": "refresh 和 left 等待的可选外部屏障",
    "child_gate": "left 和 right 等待的可选外部屏障"
  },
  "actions": [
    {
      "id": "prepare",
      "meaning": "将 count 增加 7；代码符号：build_graph.prepare",
      "input_type": "State",
      "output_type": "prepareOutput",
      "reads": [
        "parent.count",
        "calls"
      ],
      "writes": [
        "parent.count",
        "calls"
      ],
      "pre": [
        {
          "id": "snapshot_count",
          "requirement": "动作从本次调用所属图的输入快照读取 count",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.count"
              },
              {
                "path": "before.parent.count"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "output_shape",
          "requirement": "返回更新字典仅含声明的输出字段；字段存在性由输出类型约束",
          "must": {
            "op": "eq",
            "args": [
              {
                "count": {
                  "path": "output"
                }
              },
              {
                "literal": 1
              }
            ]
          }
        }
      ]
    },
    {
      "id": "refresh",
      "meaning": "使用分支快照，将 label 追加 |fresh；代码符号：build_graph.refresh",
      "input_type": "State",
      "output_type": "refreshOutput",
      "reads": [
        "parent.label",
        "parent_gate",
        "calls"
      ],
      "writes": [
        "parent.label",
        "calls"
      ],
      "pre": [
        {
          "id": "snapshot_label",
          "requirement": "动作从本次调用所属图的输入快照读取 label",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.label"
              },
              {
                "path": "before.parent.label"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "output_shape",
          "requirement": "返回更新字典仅含声明的输出字段；字段存在性由输出类型约束",
          "must": {
            "op": "eq",
            "args": [
              {
                "count": {
                  "path": "output"
                }
              },
              {
                "literal": 1
              }
            ]
          }
        }
      ]
    },
    {
      "id": "left",
      "meaning": "保留原 left，加上准备后的 count 和刷新前 label 的长度；代码符号：build_graph.left",
      "input_type": "State",
      "output_type": "leftOutput",
      "reads": [
        "child.left",
        "child.count",
        "child.label",
        "parent_gate",
        "child_gate",
        "calls"
      ],
      "writes": [
        "child.left",
        "calls"
      ],
      "pre": [
        {
          "id": "snapshot_left",
          "requirement": "动作从本次调用所属图的输入快照读取 left",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.left"
              },
              {
                "path": "before.child.left"
              }
            ]
          }
        },
        {
          "id": "snapshot_count",
          "requirement": "动作从本次调用所属图的输入快照读取 count",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.count"
              },
              {
                "path": "before.child.count"
              }
            ]
          }
        },
        {
          "id": "snapshot_label",
          "requirement": "动作从本次调用所属图的输入快照读取 label",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.label"
              },
              {
                "path": "before.child.label"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "output_shape",
          "requirement": "返回更新字典仅含声明的输出字段；字段存在性由输出类型约束",
          "must": {
            "op": "eq",
            "args": [
              {
                "count": {
                  "path": "output"
                }
              },
              {
                "literal": 1
              }
            ]
          }
        }
      ]
    },
    {
      "id": "right",
      "meaning": "保留原 right，加上准备后的 count，再减去刷新前 label 的长度；代码符号：build_graph.right",
      "input_type": "State",
      "output_type": "rightOutput",
      "reads": [
        "child.right",
        "child.count",
        "child.label",
        "child_gate",
        "calls"
      ],
      "writes": [
        "child.right",
        "calls"
      ],
      "pre": [
        {
          "id": "snapshot_right",
          "requirement": "动作从本次调用所属图的输入快照读取 right",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.right"
              },
              {
                "path": "before.child.right"
              }
            ]
          }
        },
        {
          "id": "snapshot_count",
          "requirement": "动作从本次调用所属图的输入快照读取 count",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.count"
              },
              {
                "path": "before.child.count"
              }
            ]
          }
        },
        {
          "id": "snapshot_label",
          "requirement": "动作从本次调用所属图的输入快照读取 label",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.label"
              },
              {
                "path": "before.child.label"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "output_shape",
          "requirement": "返回更新字典仅含声明的输出字段；字段存在性由输出类型约束",
          "must": {
            "op": "eq",
            "args": [
              {
                "count": {
                  "path": "output"
                }
              },
              {
                "literal": 1
              }
            ]
          }
        }
      ]
    },
    {
      "id": "analysis_export",
      "meaning": "编译子图的输出投影边界；代码符号：AnalysisOutput、child.compile() 及父节点 analysis。不是新增的 Python 回调，也不记入 calls。",
      "input_type": "State",
      "output_type": "AnalysisOutput",
      "reads": [
        "child.left",
        "child.right"
      ],
      "writes": [
        "parent.left",
        "parent.right"
      ],
      "pre": [
        {
          "id": "child_left",
          "requirement": "输出投影取自子分支合并后的状态",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.left"
              },
              {
                "path": "before.child.left"
              }
            ]
          }
        },
        {
          "id": "child_right",
          "requirement": "输出投影取自子分支合并后的状态",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.right"
              },
              {
                "path": "before.child.right"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "project_left",
          "requirement": "投影保持子图结果 left",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.left"
              },
              {
                "path": "input.left"
              }
            ]
          }
        },
        {
          "id": "project_right",
          "requirement": "投影保持子图结果 right",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.right"
              },
              {
                "path": "input.right"
              }
            ]
          }
        },
        {
          "id": "only_results",
          "requirement": "输出类型要求 left/right 存在且字典只有两个键，因此不回写 count/label",
          "must": {
            "op": "eq",
            "args": [
              {
                "count": {
                  "path": "output"
                }
              },
              {
                "literal": 2
              }
            ]
          }
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "prepare",
      "to": "refresh",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ],
      "meaning": "prepare 的更新经父状态合并后送入同一步并行分支；子动作经 analysis 输入快照接收"
    },
    {
      "from": "prepare",
      "to": "left",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ],
      "meaning": "prepare 的更新经父状态合并后送入同一步并行分支；子动作经 analysis 输入快照接收"
    },
    {
      "from": "prepare",
      "to": "right",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ],
      "meaning": "prepare 的更新经父状态合并后送入同一步并行分支；子动作经 analysis 输入快照接收"
    },
    {
      "from": "left",
      "to": "analysis_export",
      "bindings": [
        {
          "output": "left",
          "input": "left"
        }
      ],
      "meaning": "子分支更新合并后交给编译子图输出投影"
    },
    {
      "from": "right",
      "to": "analysis_export",
      "bindings": [
        {
          "output": "right",
          "input": "right"
        }
      ],
      "meaning": "子分支更新合并后交给编译子图输出投影"
    }
  ],
  "relations": [
    {
      "kind": "parallel",
      "members": [
        "refresh",
        "analysis"
      ],
      "after": "prepare",
      "meaning": "父图 prepare 的两条出边同时调度 refresh 与已编译子图 analysis。analysis 是图容器。"
    },
    {
      "kind": "contains",
      "container": "analysis",
      "members": [
        "left",
        "right",
        "analysis_export"
      ]
    },
    {
      "kind": "parallel",
      "members": [
        "left",
        "right"
      ],
      "meaning": "子图 START 的两条出边；无 left→right 或 right→left 顺序依赖。"
    },
    {
      "kind": "snapshot",
      "source": "parent after prepare",
      "target": "child initial state",
      "fields": [
        "count",
        "label",
        "left",
        "right"
      ],
      "meaning": "analysis 接收 prepare 后的完整快照；refresh 的并行更新不进入本次子图。"
    },
    {
      "kind": "join",
      "members": [
        "refresh",
        "analysis_export"
      ],
      "target": "parent END",
      "meaning": "label 与 left/right 写入不同父通道，count 保留 prepare 结果。"
    }
  ],
  "required_actions": [
    "prepare",
    "refresh",
    "left",
    "right",
    "analysis_export"
  ],
  "requirements": [
    {
      "id": "exact_values",
      "requirement": "输入 (c,l,a,b) 的成功结果必须为 count=c+7, label=l+\"|fresh\", left=a+c+7+len(l), right=b+c+7-len(l)。",
      "verification": "test_app.py 的独立 expected 计算验证 144 组笛卡尔积输入，另验证输出再次作为输入；smoke 验证公开输入。谓词语言不支持加法及字符串拼接，这些等式未伪装成结构谓词。"
    },
    {
      "id": "concurrency",
      "requirement": "保持父分支和子分支两处并行。",
      "verification": "test_both_parallel_levels 使用两个 Barrier(2, timeout=5)，连续成功 10 次；test_real_graph_topology_and_reusable_child 检查实际编译图拓扑。"
    },
    {
      "id": "once",
      "requirement": "每次成功调用 prepare/refresh/left/right 各记录一次。",
      "verification": "输入矩阵及屏障测试逐次检查 Counter；同图 24 次并发检查总次数，多图 24 次并发逐图检查日志。失败调用可能只执行部分动作，不保证完整动作集合或回滚日志。"
    },
    {
      "id": "isolation",
      "requirement": "多次调用和多个图保持状态独立，保留原 left/right。",
      "verification": "test_inputs_and_reuse、test_concurrent_invocations_and_graph_isolation 和独立子图重复调用测试。"
    },
    {
      "id": "exceptions",
      "requirement": "不吞掉动作及 gate 异常。",
      "verification": "test_exceptions_propagate_and_recovery 检查两种 gate 的异常、非法 count 引发的 TypeError 及失败后正常调用。"
    }
  ],
  "scope": {
    "description": "当前 app.py 的父图准备、父级并行刷新与分析、子级并行计算，以及子图输出投影的最小结构。图为真实 CompiledStateGraph；修复将子图输出限制为 left/right，避免与父刷新争写 label。",
    "limitations": [
      "number 仅为交付格式可表达的类型；代码 TypedDict 的 count/left/right 注解为 int，未新增运行时输入校验。",
      "pre 描述快照交接契约，不是代码中的显式 assert；未采集包含 before/after 的逐动作事件，未运行顺序 trace 检查器来冒充并发证明。",
      "结构验证仅核对声明与引用；精确算术、字符串拼接、动作恰好一次及并行性由独立行为测试验证，不由本模型谓词完整表达。",
      "测试为有限同步 invoke 样本及有限线程调度；未穷举调度，未验证 ainvoke、持久化、重试、取消、分布式执行或所有异常类别。",
      "calls 和 gate 属于调用方提供的外部对象；跨图共享这些对象会共享记录或屏障，这不属于内部状态隔离保证。",
      "LangGraph 调度及通道合并的内部实现未建模；有关快照与输出投影的判断来自当前已安装依赖下的行为测试和图结构。"
    ],
    "evidence": [
      {
        "path": "app.py",
        "start": 6,
        "end": 15,
        "supports": "父子内部完整状态以及仅含 left/right 的 AnalysisOutput。"
      },
      {
        "path": "app.py",
        "start": 18,
        "end": 25,
        "supports": "公开 build_graph 参数、按实例捕获 calls、prepare 记录一次并将 count 加 7。"
      },
      {
        "path": "app.py",
        "start": 27,
        "end": 45,
        "supports": "刷新和两路分析的精确表达式、原累积值、屏障位置及无异常捕获。"
      },
      {
        "path": "app.py",
        "start": 47,
        "end": 52,
        "supports": "子图完整输入与窄输出，START 同时指向 left/right。"
      },
      {
        "path": "app.py",
        "start": 53,
        "end": 62,
        "supports": "父图嵌入编译子图，prepare 后双分支和 END 汇合，返回真实编译图。"
      }
    ]
  },
  "verification": {
    "behavior": {
      "command": "./run_python test_app.py",
      "result": "passed: 5 tests"
    },
    "smoke": {
      "command": "./run_python smoke.py",
      "result": {
        "count": 8,
        "label": "old|fresh",
        "left": 13,
        "right": 8
      }
    },
    "inference": "分析分支使用 prepare 后、refresh 前快照；窄输出排除了冲突通道。行为测试及代码交接共同支持，非普遍形式化证明。"
  }
