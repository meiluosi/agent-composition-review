  "resources": {
    "parent.count": "父图 count channel；prepare 单写者。",
    "parent.label": "父图 label channel；refresh 单写者。",
    "parent.left": "父图 left channel；analysis 输出更新。",
    "parent.right": "父图 right channel；analysis 输出更新。",
    "child.count": "analysis 输入快照中的已 prepare 的 count。",
    "child.label": "analysis 输入快照中的刷新前 label。",
    "child.left": "子图 left channel，初始值来自父图 left。",
    "child.right": "子图 right channel，初始值来自父图 right。",
    "calls": "可选外部追加记录容器；只记录 prepare/refresh/left/right。",
    "parent_gate": "可选外部屏障；refresh 与 left 调用 wait。",
    "child_gate": "可选外部屏障；left 与 right 调用 wait。"
  },
  "actions": [
    {
      "id": "prepare",
      "input_type": "State",
      "output_type": "CountUpdate",
      "reads": [
        "parent.count"
      ],
      "writes": [
        "parent.count",
        "calls"
      ],
      "meaning": "build_graph.prepare：记录 prepare，返回局部更新 count = input.count + 7。",
      "pre": [
        {
          "id": "prepare_count_present",
          "requirement": "input.count 必须存在且非 null；完整类型约束见 types。",
          "must": {
            "op": "ne",
            "args": [
              {
                "path": "input.count"
              },
              {
                "literal": null
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "prepare_changes_count",
          "requirement": "整数 count 加 7 后不同于输入；完整加法要求另列。",
          "must": {
            "op": "ne",
            "args": [
              {
                "path": "output.count"
              },
              {
                "path": "input.count"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "analysis_input",
      "input_type": "State",
      "output_type": "State",
      "reads": [
        "parent.count",
        "parent.label",
        "parent.left",
        "parent.right"
      ],
      "writes": [
        "child.count",
        "child.label",
        "child.left",
        "child.right"
      ],
      "meaning": "框架边界而非额外业务节点：parent 的 analysis 节点将 prepare 超步提交后的 State 传入 child。与 refresh 同一父图超步，复制所有四字段。",
      "pre": [
        {
          "id": "analysis_input_count",
          "requirement": "input.count 必须存在且非 null；完整类型约束见 types。",
          "must": {
            "op": "ne",
            "args": [
              {
                "path": "input.count"
              },
              {
                "literal": null
              }
            ]
          }
        },
        {
          "id": "analysis_input_label",
          "requirement": "input.label 必须存在且非 null；完整类型约束见 types。",
          "must": {
            "op": "ne",
            "args": [
              {
                "path": "input.label"
              },
              {
                "literal": null
              }
            ]
          }
        },
        {
          "id": "analysis_input_left",
          "requirement": "input.left 必须存在且非 null；完整类型约束见 types。",
          "must": {
            "op": "ne",
            "args": [
              {
                "path": "input.left"
              },
              {
                "literal": null
              }
            ]
          }
        },
        {
          "id": "analysis_input_right",
          "requirement": "input.right 必须存在且非 null；完整类型约束见 types。",
          "must": {
            "op": "ne",
            "args": [
              {
                "path": "input.right"
              },
              {
                "literal": null
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "analysis_copy_count",
          "requirement": "边界保持 count 的值。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.count"
              },
              {
                "path": "input.count"
              }
            ]
          }
        },
        {
          "id": "analysis_copy_label",
          "requirement": "边界保持 label 的值。",
          "must": {
