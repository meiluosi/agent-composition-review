  "relations": [
    {
      "kind": "initial_state",
      "description": "调用者 State 初始化 parent channels；prepare 只更新 count，label/left/right 保留原值。refresh 从父图旧 label 读取；analysis_input 从同一超步快照读取四字段。未将外部初始化虚构为代码节点。"
    },
    {
      "kind": "control_fanout",
      "from": "prepare",
      "branches": [
        "refresh",
        "analysis_input"
      ],
      "description": "代码 prepare -> refresh 和 prepare -> analysis 两条边构成并行父分支；无 refresh -> analysis 数据依赖。"
    },
    {
      "kind": "control_fanout",
      "from": "analysis_input",
      "branches": [
        "left",
        "right"
      ],
      "description": "child START 同时连向 left/right，无左右先后约束。"
    },
    {
      "kind": "join",
      "branches": [
        "left",
        "right"
      ],
      "to": "analysis_output",
      "description": "子图完成后按输出 schema 投影。"
    },
    {
      "kind": "join",
      "branches": [
        "refresh",
        "analysis_output"
      ],
      "to": "result",
      "description": "父图结束时按互不重叠字段合并分支更新。"
    },
    {
      "kind": "data_provenance",
      "description": "edges 表示通过框架 channels 的字段交接，不等同于 add_edge 拓扑；其余被保留的字段由初始状态提供。"
    },
    {
      "kind": "side_effect",
      "description": "各业务函数在等待或计算之前调用 record；calls 不属于返回 State。调用者主动共享 calls/gate 时共享的是外部观察器，不是图状态。"
    }
  ],
  "requirements": [
    {
      "id": "exact_values",
      "statement": "完整整数输入 (c,l,a,b) 的正常父图调用返回 count=c+7，label=l+\"|fresh\"，left=a+c+7+len(l)，right=b+c+7-len(l)，且仅有这四字段。",
      "verification": "smoke.py；test_inputs_and_repeated_invocations；test_both_parallel_boundaries。"
    },
    {
      "id": "parallelism",
      "statement": "保留父图并行 refresh/analysis 与子图并行 left/right。",
      "verification": "test_both_parallel_boundaries 使用两组 Barrier(2, timeout=5)，重复五次；test_reusable_real_subgraph_and_topology 检查编译类型和实际边。"
    },
    {
      "id": "reuse_and_isolation",
      "statement": "子图是真实可独立调用的编译子图；重复父图调用、多个父图之间以及同图并发调用不串状态。",
      "verification": "test_reusable_real_subgraph_and_topology、test_inputs_and_repeated_invocations、test_multiple_graphs_and_simultaneous_calls、test_async_invocations。"
    },
    {
      "id": "exact_calls",
      "statement": "一次正常父图调用记录 prepare/refresh/left/right 各一次；不约束并行记录顺序。",
      "verification": "顺序、屏障、线程并发及异步测试使用 Counter 检查每种动作次数；顺序/屏障每次调用后均检查。"
    },
    {
      "id": "exceptions",
      "statement": "动作或屏障异常向调用者传播，不转换为成功结果；失败调用不保证所有动作均执行。",
      "verification": "test_gate_exceptions_propagate 对两种 gate 注入异常；test_action_exceptions_propagate 检查非法 count 的 TypeError。"
    }
  ],
