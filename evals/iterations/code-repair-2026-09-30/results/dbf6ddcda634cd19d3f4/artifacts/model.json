  "resources": {
    "parent_count": "每次调用独立的父图 count 通道；读取采用对应 superstep 输入快照。",
    "parent_label": "每次调用独立的父图 label 通道；读取采用对应 superstep 输入快照。",
    "parent_left": "每次调用独立的父图 left 通道；读取采用对应 superstep 输入快照。",
    "parent_right": "每次调用独立的父图 right 通道；读取采用对应 superstep 输入快照。",
    "child_count": "每次子图执行独立的 count 通道，由 prepare 后父状态初始化。",
    "child_label": "每次子图执行独立的 label 通道，由 prepare 后父状态初始化。",
    "child_left": "每次子图执行独立的 left 通道，由 prepare 后父状态初始化。",
    "child_right": "每次子图执行独立的 right 通道，由 prepare 后父状态初始化。",
    "calls": "调用者传入的可选列表；闭包保存其引用，每个业务动作开始时 append 一次。共享同一列表属于调用者显式共享。",
    "parent_gate": "调用者传入的可选屏障；refresh 和 left 各 wait 一次，会改变屏障内部状态。",
    "child_gate": "调用者传入的可选屏障；left 和 right 各 wait 一次，会改变屏障内部状态。"
  },
  "actions": [
    {
      "id": "prepare",
      "meaning": "build_graph.prepare：记录动作，count 增加 7，只返回 count 补丁。",
      "input_type": "State",
      "output_type": "CountPatch",
      "reads": [
        "parent_count",
        "calls"
      ],
      "writes": [
        "parent_count",
        "calls"
      ],
      "pre": [
        {
          "id": "snapshot_count",
          "requirement": "动作读取其调度时的输入快照；before 表示该动作的局部逻辑视图。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.count"
              },
              {
                "path": "before.parent_count"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "commit_count",
          "requirement": "正常返回的补丁对应其目标通道提交值；不代表已编码算术公式。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.count"
              },
              {
                "path": "after.parent_count"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "refresh",
      "meaning": "build_graph.refresh：记录动作，可等待父屏障，label 追加 |fresh。",
      "input_type": "State",
      "output_type": "LabelPatch",
      "reads": [
        "parent_label",
        "calls",
        "parent_gate"
      ],
      "writes": [
        "parent_label",
        "calls",
        "parent_gate"
      ],
      "pre": [
        {
          "id": "snapshot_label",
          "requirement": "动作读取其调度时的输入快照；before 表示该动作的局部逻辑视图。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "input.label"
              },
              {
                "path": "before.parent_label"
              }
            ]
          }
        }
      ],
      "post": [
        {
          "id": "commit_label",
          "requirement": "正常返回的补丁对应其目标通道提交值；不代表已编码算术公式。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.label"
              },
              {
                "path": "after.parent_label"
              }
            ]
