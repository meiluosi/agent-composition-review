        }
      ],
      "post": [
        {
          "id": "refresh_preserves_text",
          "requirement": "输出包含原始文本；精确后缀拼接由行为测试检查。",
          "must": {
            "op": "contains",
            "args": [
              {
                "path": "output.label"
              },
              {
                "path": "input.label"
              }
