+def _text_key(value):
+    """Keep existing TEXT keys; store strings SQLite cannot encode as BLOBs."""
+    try:
+        value.encode("utf-8")
+    except UnicodeEncodeError:
+        return value.encode("utf-8", "surrogatepass")
+    return value
 
 
