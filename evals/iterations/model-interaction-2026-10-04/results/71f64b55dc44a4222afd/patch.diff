+def _sqlite_string(value):
+    """Preserve strings containing lone surrogates, which SQLite TEXT rejects."""
+    try:
+        value.encode("utf-8")
+    except UnicodeEncodeError:
+        return value.encode("utf-8", errors="surrogatepass")
+    return value
 
 
