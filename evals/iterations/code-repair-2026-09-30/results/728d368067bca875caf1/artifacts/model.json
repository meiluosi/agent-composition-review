{
  "schema_version": 1,
  "types": {
    "State": {
      "count": {
        "type": "number"
      },
      "label": {
        "type": "string"
      },
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    },
    "CountPatch": {
      "count": {
        "type": "number"
      }
    },
    "LabelPatch": {
      "label": {
        "type": "string"
      }
    },
    "LeftPatch": {
      "left": {
        "type": "number"
      }
    },
    "RightPatch": {
      "right": {
        "type": "number"
      }
    },
    "AnalysisOutput": {
      "left": {
        "type": "number"
      },
      "right": {
        "type": "number"
      }
    }
  },
  "resources": {
    "parent.count": "父图 State.count 通道",
    "parent.label": "父图 State.label 通道",
    "parent.left": "父图 State.left 通道",
    "parent.right": "父图 State.right 通道",
    "analysis.count": "子图 State.count 通道；入口复制 prepare 完成后的父图快照",
    "analysis.label": "子图 State.label 通道；入口复制 prepare 完成后的父图快照",
    "analysis.left": "子图 State.left 通道；入口复制 prepare 完成后的父图快照",
    "analysis.right": "子图 State.right 通道；入口复制 prepare 完成后的父图快照"
  },
  "actions": [
    {
      "id": "prepare",
      "input_type": "State",
      "output_type": "CountPatch",
      "reads": [
        "parent.count"
      ],
      "writes": [
        "parent.count"
      ],
      "pre": [],
      "post": [
        {
          "id": "count_increases",
          "requirement": "count 必须增加；此谓词仅检查必要条件，精确 +7 由公式及行为测试覆盖。",
          "must": {
            "op": "ge",
            "args": [
              {
                "path": "output.count"
              },
              {
                "path": "input.count"
              }
            ]
          }
        }
      ],
      "meaning": "build_graph.prepare：将本次输入 count 加 7，返回局部更新。",
      "exact_requirement": "output.count = input.count + 7"
    },
    {
      "id": "refresh",
      "input_type": "State",
      "output_type": "LabelPatch",
      "reads": [
        "parent.label"
      ],
      "writes": [
        "parent.label"
      ],
      "pre": [],
      "post": [
        {
          "id": "fresh_marker",
          "requirement": "输出包含追加标记；此谓词不单独证明精确后缀或保留原字符串。",
          "must": {
            "op": "contains",
            "args": [
              {
                "path": "output.label"
              },
              {
                "literal": "|fresh"
              }
            ]
          }
        }
      ],
      "meaning": "build_graph.refresh：与 analysis 并行，将入口 label 追加 |fresh。",
      "exact_requirement": "output.label = input.label + '|fresh'"
    },
    {
      "id": "left",
      "input_type": "State",
      "output_type": "LeftPatch",
      "reads": [
        "analysis.left",
        "analysis.count",
        "analysis.label"
      ],
      "writes": [
        "analysis.left"
      ],
      "pre": [],
      "post": [
        {
          "id": "left_nondecreasing_when_count_nonnegative",
          "requirement": "count 非负时 left 不减；只表达精确公式的一个推论。",
          "must": {
            "op": "ge",
            "args": [
              {
                "path": "output.left"
              },
              {
                "path": "input.left"
              }
            ]
          },
          "when": {
            "op": "ge",
            "args": [
              {
                "path": "input.count"
              },
              {
                "literal": 0
              }
            ]
          }
        }
      ],
      "meaning": "build_graph.left：保留原 left 并累加已 prepare 的 count 与旧 label 的 Python 字符长度。",
      "exact_requirement": "output.left = input.left + input.count + len(input.label)"
    },
    {
      "id": "right",
      "input_type": "State",
      "output_type": "RightPatch",
      "reads": [
        "analysis.right",
        "analysis.count",
        "analysis.label"
      ],
      "writes": [
        "analysis.right"
      ],
      "pre": [],
      "post": [
        {
          "id": "right_nondecreasing_when_count_covers_label",
          "requirement": "count 至少为 label 长度时 right 不减；只表达精确公式的一个推论。",
          "must": {
            "op": "ge",
            "args": [
              {
                "path": "output.right"
              },
              {
                "path": "input.right"
              }
            ]
          },
          "when": {
            "op": "ge",
            "args": [
              {
                "path": "input.count"
              },
              {
                "count": {
                  "path": "input.label"
                }
              }
            ]
          }
        }
      ],
      "meaning": "build_graph.right：保留原 right 并累加已 prepare 的 count，减去旧 label 的 Python 字符长度。",
      "exact_requirement": "output.right = input.right + input.count - len(input.label)"
    },
    {
      "id": "analysis_output",
      "input_type": "AnalysisOutput",
      "output_type": "AnalysisOutput",
      "reads": [
        "analysis.left",
        "analysis.right"
      ],
      "writes": [
        "parent.left",
        "parent.right"
      ],
      "pre": [],
      "post": [
        {
          "id": "publish_left",
          "requirement": "原样发布子图 left 结果。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.left"
              },
              {
                "path": "input.left"
              }
            ]
          }
        },
        {
          "id": "publish_right",
          "requirement": "原样发布子图 right 结果。",
          "must": {
            "op": "eq",
            "args": [
              {
                "path": "output.right"
              },
              {
                "path": "input.right"
              }
            ]
          }
        }
      ],
      "meaning": "AnalysisOutput 与 child.compile() 的输出边界：LangGraph 汇合 left/right，仅将两个结果字段写回父图；不是新增 Python 函数或额外记录动作。",
      "exact_requirement": "output = {left: input.left, right: input.right}; output 不包含 count/label"
    }
  ],
  "edges": [
    {
      "from": "prepare",
      "to": "refresh",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ],
      "meaning": "prepare 的局部更新经父图状态合并后交接；对 left/right 还经过子图入口快照。不是省略节点后的直接控制边。"
    },
    {
      "from": "prepare",
      "to": "left",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ],
      "meaning": "prepare 的局部更新经父图状态合并后交接；对 left/right 还经过子图入口快照。不是省略节点后的直接控制边。"
    },
    {
      "from": "prepare",
      "to": "right",
      "bindings": [
        {
          "output": "count",
          "input": "count"
        }
      ],
      "meaning": "prepare 的局部更新经父图状态合并后交接；对 left/right 还经过子图入口快照。不是省略节点后的直接控制边。"
    },
    {
      "from": "left",
      "to": "analysis_output",
      "bindings": [
        {
          "output": "left",
          "input": "left"
        }
      ]
    },
    {
      "from": "right",
      "to": "analysis_output",
      "bindings": [
        {
          "output": "right",
          "input": "right"
        }
      ]
    }
  ],
  "required_actions": [
    "prepare",
    "refresh",
    "left",
    "right",
    "analysis_output"
  ],
  "relations": [
    {
      "kind": "parent_fork",
      "after": "prepare",
      "branches": [
        "refresh",
        [
          "left",
          "right",
          "analysis_output"
        ]
      ],
      "meaning": "实际父图边为 prepare→refresh、prepare→analysis；analysis 是嵌入的真实编译子图。"
    },
    {
      "kind": "child_fork",
      "branches": [
        "left",
        "right"
      ],
      "meaning": "子图 START 同时启动 left/right；没有 left→right 或 right→left 控制边。"
    },
    {
      "kind": "snapshot",
      "meaning": "父图输入四字段经 prepare 只更新 count；refresh 与子图接收同一阶段快照。子图保留原始 left/right、原始 label 和 count+7。refresh 的 label 更新不交给 left/right。"
    },
    {
      "kind": "parent_join",
      "meaning": "refresh→END、analysis→END 汇合。refresh 只写 parent.label，analysis_output 只写 parent.left/right，parent.count 保留 prepare 的结果。最终输出仍为 State 四字段。"
    },
    {
      "kind": "observation",
      "meaning": "prepare/refresh/left/right 各在入口 record 一次。parent_gate 由 refresh 与 left 等待；child_gate 由 left 与 right 等待。屏障异常原样传播。"
    },
    {
      "kind": "lifetime",
      "meaning": "每次 build_graph 在闭包中绑定 calls/gates 并新建父、子图；未配置缓存或 checkpointer。正常调用没有跨次保存业务状态。调用方显式共用 calls/gates 时这些外部对象仍会共享。"
    }
  ],
  "scope": {
    "description": "当前 app.py 的父图 prepare 与 refresh、并行子图计算及输出投影。资源读写只描述业务状态通道；输入继承与最终合并用 relations 描述。边为实际字段交接，不能解释为 left/right 串行执行。",
    "limitations": [
      "types 使用格式允许的 number；代码注解要求 int，但 TypedDict 不提供运行时类型校验。只验证完整合法 State，未穷尽非法输入。",
      "pre 为空表示除输入类型契约外未编码额外前置谓词，不代表所有输入都合法。条件只编码精确要求的部分推论；exact_requirement 是需结合源码及行为测试审查的公式，不是已执行的谓词证明。",
      "未实现通用模型谓词执行器。结构检查只验证引用与字段绑定；不证明计算、并行或读写真实性。",
      "框架调度、快照隔离与输出投影依赖已安装 LangGraph。已用流式更新、子图独立调用和双层屏障验证当前环境；未覆盖其他版本、所有调度、分布式运行或重试/恢复。",
      "calls 与 gate 的内部副作用不纳入资源读写列表；其调用位置、异常传播和并行用途由 relations、源码及测试记录。每动作恰好一次针对本任务的正常无重试调用，失败调用不保证全部动作完成。",
      "有限重复、同图并发及跨图并发测试支持调用独立性，不是对任意外部可变对象、取消或调用方并发修改输入的证明。"
    ],
    "evidence": [
      {
        "path": "app.py",
        "start": 6,
        "end": 15,
        "supports": "父图完整 State 和仅含 left/right 的 AnalysisOutput。"
      },
      {
        "path": "app.py",
        "start": 18,
        "end": 25,
        "supports": "公开接口、闭包绑定 calls、prepare 精确加 7。"
      },
      {
        "path": "app.py",
        "start": 27,
        "end": 45,
        "supports": "刷新与两个分析公式、每个动作的记录、两层 gate 调用；无异常捕获。"
      },
      {
        "path": "app.py",
        "start": 47,
        "end": 52,
        "supports": "子图完整输入、窄输出及 START 两个并行分支。"
      },
      {
        "path": "app.py",
        "start": 53,
        "end": 62,
        "supports": "嵌入编译子图、prepare 后父分支并行、终点汇合、返回真实编译父图。"
      }
    ]
  },
  "validation": {
    "executed": [
      {
        "command": "./run_python smoke.py",
        "result": "原始实现抛 InvalidUpdateError: label；修复后输出 count=8, label=old|fresh, left=13, right=8。"
      },
      {
        "command": "./run_python -m unittest -v test_app.py",
        "result": "8 项通过：负数/空串/Unicode/大整数、重复与反馈调用、双层屏障、真实编译结构及子图复用、同图与跨图并发、更新字段归属、gate 异常传播、异步调用。"
      }
    ],
    "inferred": [
      "父并行分支输出资源不相交：refresh 写 label，analysis 写 left/right，因此消除了原来的 label 多写冲突。",
      "app.py 无新增辅助模块依赖；除类型声明和子图输出 schema 外，原始计算与拓扑保持不变。"
    ]
  }
}
