 import math
 import sqlite3
 from contextlib import closing
+
+
+def _stored_string(value):
+    """Keep ordinary SQLite text compatible with existing queue files.
+
+    Python strings may also contain surrogate code points, which SQLite's
+    UTF-8 text adapter rejects. Store only those strings as lossless blobs;
+    this also keeps surrogate pairs distinct from single Unicode characters.
+    """
+    try:
+        value.encode('utf-8')
+    except UnicodeEncodeError:
+        return value.encode('utf-8', errors='surrogatepass')
+    return value
+
+
+def _loaded_string(value):
+    if isinstance(value, bytes):
+        return value.decode('utf-8', errors='surrogatepass')
+    return value
 
 
